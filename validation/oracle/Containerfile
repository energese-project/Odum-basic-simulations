# The oracle for spike 0.1: PC-BASIC, an emulator of GW-BASIC and BASICA, number
# format included. It is GPL-3.0, so it lives in this image and nowhere else —
# never vendored, bundled or copied into the site or the command-line tool.
#
# Everything is pinned, the base by digest and pcbasic's dependencies as well as
# pcbasic. An oracle that changes under us is not one.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2

RUN pip install --no-cache-dir pcbasic==2.0.8 pysdl2-dll==2.32.10 pyserial==3.5

WORKDIR /work
ENTRYPOINT ["pcbasic"]
